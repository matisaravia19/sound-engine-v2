+    if (!stageid || *stageid < 0 || static_cast<size_t>(*stageid) > N ||
+        !vkfft_scheduler::tree_list_valid(raderContainer, numRaderPrimes, depth)) return VKFFT_ERROR_MATH_FAILED;
+    for (int i = 0; i < numRaderPrimes; ++i) {
+        auto& rader = raderContainer[i];
+        if (rader.multiplier < 0 || rader.prime < 2 || rader.generator <= 0 || rader.generator >= rader.prime ||
+            (rader.type != 0 && rader.type != 1)) return VKFFT_ERROR_MATH_FAILED;
+        while (rader.multiplier > 0) {
+            auto res = vkfft_scheduler::append_stage(*stageid, stageRadix, stage_rader_generator, rader.prime, rader.generator);
+            if (res != VKFFT_SUCCESS) return res;
+            --rader.multiplier;
+        }
+    }
+    for (int i = 0; i < numRaderPrimes; ++i) {
+        auto& rader = raderContainer[i];
+        if (rader.type != 0) continue;
+        if (rader.numStages < 0 || rader.numStages > static_cast<int>(sizeof(rader.stageRadix) / sizeof(rader.stageRadix[0])))
+            return VKFFT_ERROR_MATH_FAILED;
+        if (rader.numSubPrimes != 0) {
+            auto res = VkFFTGetRaderFFTStages(rader.container, rader.numSubPrimes, &rader.numStages, rader.stageRadix, rader.stage_rader_generator, depth + 1);
+            if (res != VKFFT_SUCCESS) return res;
